// Candila TradeSync — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  USER
}

enum Broker {
  ZERODHA
  FYERS
  ANGEL_ONE
  UPSTOX
  DHAN
  ICICI_DIRECT
  SHOONYA
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
  EXPIRED
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AccountType {
  MASTER
  FOLLOWER
}

// Sprint 1 — single-use, expiring auth token purposes (email verification and
// password reset). Only a SHA-256 hash of the token is stored (see AuthToken).
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)

  // Sprint 1 — production onboarding / authorization foundation.
  // emailVerified gates LIVE eligibility (not authentication). Existing rows
  // are backfilled to true by the migration so current users are never locked
  // out. passwordChangedAt revokes JWTs issued before a reset/change.
  emailVerified    Boolean   @default(false)
  emailVerifiedAt  DateTime?
  termsAcceptedAt  DateTime?
  termsVersion     String?
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradingAccounts TradingAccount[]
  followerLinks   Follower[]       @relation("FollowerUser")
  subscriptions   Subscription[]
  authTokens      AuthToken[]

  @@index([email])
  @@map("users")
}

// Sprint 1 — Email verification & password reset tokens. Single-use
// (usedAt), time-boxed (expiresAt). ONLY the SHA-256 hash of the raw token is
// persisted; the raw token exists only inside the emailed link.
model AuthToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model TradingAccount {
  id                  String           @id @default(uuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker              Broker
  platform            String
  nickname            String
  clientId            String
  encryptedApiKey     String?
  encryptedApiSecret  String?
  encryptedVendorCode String?
  encryptedPassword   String?
  encryptedTotpSecret String?
  staticIpPrimary     String?
  staticIpSecondary   String?
  connectionStatus    ConnectionStatus @default(DISCONNECTED)
  accountType         AccountType      @default(FOLLOWER)
  enabled             Boolean          @default(true)
  healthScore         Int              @default(0)
  lastHeartbeat       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  strategies     Strategy[]
  followerLinks  Follower[]         @relation("FollowerTradingAccount")
  brokerSessions BrokerSession[]

  @@index([userId])
  @@index([accountType])
  @@map("trading_accounts")
}

model Strategy {
  id               String         @id @default(uuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
  strategyName     String
  description      String?
  enabled          Boolean        @default(true)
  visibility       Visibility     @default(PRIVATE)
  masterAccount    Boolean        @default(false)
  baseQuantity     Int            @default(1)
  maxFollowers     Int            @default(0)
  status           StrategyStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  followers     Follower[]
  subscriptions Subscription[]

  @@index([tradingAccountId])
  @@map("strategies")
}

model Follower {
  id               String         @id @default(uuid())
  strategyId       String
  strategy         Strategy       @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  followerUserId   String
  followerUser     User           @relation("FollowerUser", fields: [followerUserId], references: [id], onDelete: Cascade)
  tradingAccountId String
  tradingAccount   TradingAccount @relation("FollowerTradingAccount", fields: [tradingAccountId], references: [id], onDelete: Cascade)
  multiplier       Float          @default(1.0)
  maximumLoss      Float?
  maximumDailyLoss Float?
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([strategyId, followerUserId])
  @@index([strategyId])
  @@index([followerUserId])
  @@index([tradingAccountId])
  @@map("followers")
}

model Subscription {
  id             String             @id @default(uuid())
  followerUserId String
  followerUser   User               @relation(fields: [followerUserId], references: [id], onDelete: Cascade)
  strategyId     String
  strategy       Strategy           @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  status         SubscriptionStatus @default(TRIAL)
  startDate      DateTime           @default(now())
  endDate        DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([followerUserId])
  @@index([strategyId])
  @@map("subscriptions")
}

model BrokerSession {
  id                   String   @id @default(uuid())

  tradingAccountId     String 
  tradingAccount       TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  broker               Broker

  encryptedAccessToken String
  publicToken          String?

  userId               String
  userName             String

  loginTime            DateTime @default(now())
  expiresAt            DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tradingAccountId, broker])
  @@index([tradingAccountId])
  @@map("broker_sessions")
}

model Instrument {
  id             String   @id @default(uuid())

  contractKey    String   @unique

  exchange       String
  segment        String
  underlying     String
  instrumentType String

  expiry         DateTime?

  strike         Float?

  optionType     String?

  lotSize        Int

  tickSize       Float?

  createdAt      DateTime @default(now())

  brokers        InstrumentBroker[]

  @@index([exchange])
  @@index([segment])
  @@index([underlying])
  @@index([expiry])
  @@index([strike])

  @@map("instruments")
}

model InstrumentBroker {
  id             String   @id @default(uuid())

  instrumentId   String

  instrument      Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  broker         Broker

  brokerSymbol   String

  // Sprint 6.2.8 — a broker symbol is NOT globally unique. The same tradingsymbol
  // (e.g. "TCS") is listed on both NSE and BSE. Without exchange in the unique key
  // the second exchange's upsert collided with the first and only one listing
  // survived — the root cause of "TCS shows only on BSE, NSE missing".
  exchange       String

  brokerToken    String?

  exchangeSymbol String?

  exchangeToken  String?

  createdAt      DateTime @default(now())

  @@unique([broker, brokerSymbol, exchange])

  @@index([instrumentId])

  @@index([broker])

  @@index([broker, brokerSymbol])

  @@map("instrument_brokers")
}

// ---------- Execution audit (Sprint 5.2) ----------
//
// Permanent operational audit trail written by CopyTradingService via
// the ExecutionHistoryPersistenceService. Never overwritten, never
// mutated after insert — one ExecutionHistory row per handleTrade()
// invocation and one ExecutionFollowerResult row per follower attempt.

model ExecutionHistory {
  id                  String   @id @default(uuid())

  timestamp           DateTime

  strategyId          String?
  strategyName        String?

  masterAccountId     String
  masterAccountName   String?
  masterBroker        String
  masterSymbol        String
  masterExchange      String?
  masterSegment       String?

  masterSide          String
  masterQuantity      Int
  masterPrice         Float?

  orderType           String?
  productType         String?
  tradeSource         String?

  // Overall outcome for the master trade:
  //   COMPLETED / PARTIAL / FAILED / NO_STRATEGY / NO_FOLLOWERS / ERROR
  status              String

  totalFollowers      Int      @default(0)
  successfulFollowers Int      @default(0)
  failedFollowers     Int      @default(0)
  skippedFollowers    Int      @default(0)

  processingTimeMs    Int?

  createdAt           DateTime @default(now())

  followers ExecutionFollowerResult[]

  @@index([timestamp])
  @@index([createdAt])
  @@index([strategyId])
  @@index([masterAccountId])
  @@index([masterBroker])
  @@index([masterSymbol])
  @@index([status])

  @@map("execution_history")
}

model ExecutionFollowerResult {
  id                 String   @id @default(uuid())

  executionHistoryId String
  executionHistory   ExecutionHistory @relation(fields: [executionHistoryId], references: [id], onDelete: Cascade)

  followerId       String?
  followerEmail    String?
  broker           String

  brokerOrderId    String?

  // Per-follower outcome:
  //   PENDING / EXECUTING / SUCCESS / FAILED / SKIPPED
  status           String

  // Classification bucket for failed/skipped attempts. Free-form so
  // future adapter-specific classifications can be added without a
  // migration. Reuses the values produced by
  // copy-trading/execution-event.recorder.classifyFailure.
  failureType      String?
  failureReason    String?

  rawBrokerResponse Json?

  followerSymbol    String?
  executedQuantity  Int?
  executedPrice     Float?

  startedAt         DateTime?
  completedAt       DateTime?

  createdAt         DateTime @default(now())

  @@index([executionHistoryId])
  @@index([status])
  @@index([broker])
  @@index([failureType])

  @@map("execution_follower_results")
}