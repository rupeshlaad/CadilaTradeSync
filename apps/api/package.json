{
  "name": "@cts/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cadila TradeSync API (NestJS)",
  "scripts": {
    "dev": "pnpm run prisma:generate && nest start --watch",
    "build": "pnpm run prisma:generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate --schema=../../database/prisma/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=../../database/prisma/prisma/schema.prisma"
  },
  "dependencies": {
    "@cts/database": "workspace:*",
    "@cts/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.0.1",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^6.1.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "crypto-js": "^4.2.0",
    "csv-parse": "^7.0.1",
    "fyers-api-v3": "^2.0.0",
    "getmac": "^6.6.0",
    "ioredis": "^5.4.1",
    "kiteconnect": "^5.3.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
