# ---------------------------------------------
# Cadila TradeSync — Root env (used by docker)
# ---------------------------------------------

# Postgres
POSTGRES_USER=cts
POSTGRES_PASSWORD=cts_password
POSTGRES_DB=cts_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=4000
JWT_SECRET=change-me-super-secret-key
JWT_EXPIRES_IN=7d

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin
ADMIN_PORT=3001
